# ---------------------------------------------------------------- database
# Local Docker Postgres (current default):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/babultech_crm?schema=public"

# Supabase cloud — replace the above with BOTH of these.
#
# Take them from: Dashboard > Project Settings > Database > Connection string.
# The password is the one set when the project was created; it is shown only
# once and cannot be recovered from any API token afterwards. If it is lost,
# reset it under Database > Database password.
#
# DATABASE_URL must use the POOLER on port 6543 (pgbouncer, transaction mode)
# because Next.js server actions open many short-lived connections.
# DIRECT_URL must use port 5432, because Prisma migrations need a real session
# and cannot run through a transaction-mode pooler.
#
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- auth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# --------------------------------------------------- supabase (steps 2 & 4)
# Not needed for step 1 (database move). Required once Supabase Auth and
# supabase-js come in. From: Project Settings > API.
#
# NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon key]"
# SUPABASE_SERVICE_ROLE_KEY="[service role key]"   # server-only, never expose
#
# NOTE: a `sbp_...` personal access token is NOT any of these. That is a
# management-API token for the CLI, it is scoped to your whole account, and it
# does not belong in this file.
