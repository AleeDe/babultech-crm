# ---------------------------------------------------------------- database
# Local Docker Postgres (current default):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/babultech_crm?schema=public"

# Supabase cloud — replace the above with BOTH of these.
#
# Take them from: Dashboard > Project Settings > Database > Connection string.
# The password is the one set when the project was created; it is shown only
# once and cannot be recovered from any API token afterwards. If it is lost,
# reset it under Database > Database password.
#
# DATABASE_URL must use the POOLER on port 6543 (pgbouncer, transaction mode)
# because Next.js server actions open many short-lived connections.
# DIRECT_URL must use port 5432, because Prisma migrations need a real session
# and cannot run through a transaction-mode pooler.
#
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# The origin used to build links in notification emails. Without it the links
# point at localhost, which is right in development and wrong once deployed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------- auth
# Supabase Auth is the only identity provider — it issues the session JWT, so
# there is no separate auth secret to set. Configure sign-in behaviour (session
# length, password policy, redirect URLs) in the Supabase dashboard instead.

# --------------------------------------------------- supabase (steps 2 & 4)
# Not needed for step 1 (database move). Required once Supabase Auth and
# supabase-js come in. From: Project Settings > API.
#
# NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon key]"
# SUPABASE_SERVICE_ROLE_KEY="[service role key]"   # server-only, never expose
#
# NOTE: a `sbp_...` personal access token is NOT any of these. That is a
# management-API token for the CLI, it is scoped to your whole account, and it
# does not belong in this file.

# ------------------------------------------------------------------ vault
# Encryption key for the credential vault (/vault). AES-256-GCM, so this must
# be exactly 32 bytes encoded as base64:
#
#   openssl rand -base64 32
#
# It is deliberately NOT stored in the database. That separation is the whole
# point: a dump of the `secret` table without this key decrypts to nothing.
#
# Consequences worth understanding before you set it:
#   * Lose it and every stored value is unrecoverable. There is no reset. Keep
#     a copy in an offline password manager, not only in the hosting provider.
#   * Change it and existing rows stop decrypting — they are not re-encrypted
#     automatically. Reveal and re-save each secret before retiring an old key.
#   * Anyone holding both this key and a database dump can read every secret,
#     so it does not belong in the repository, a ticket, or a chat message.
#
# SECRET_VAULT_KEY="[32 random bytes, base64]"
