// ============================================================================
// SHARED PLATFORM (spec §10.6)
// ============================================================================

model SecurityRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  /// Permission strings, e.g. ["opportunity:read:team", "invoice:approve"].
  permissions String[]
  /// Row-level default scope: OWN | TEAM | DEPARTMENT | ALL (see src/lib/authz.ts).
  dataScope   String   @default("OWN") @db.VarChar(20)
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("security_role")
}

model Department {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(100)
  parentDepartmentId String?  @db.Uuid
  managerUserId      String?  @db.Uuid
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[] @relation("DepartmentHierarchy")
  manager          User?        @relation("DepartmentManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  users            User[]       @relation("UserDepartment")

  @@index([parentDepartmentId])
  @@map("department")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  employeeNumber     String?    @unique @db.VarChar(30)
  fullName           String     @db.VarChar(150)
  email              String     @unique @db.VarChar(255)
  passwordHash       String?
  avatarUrl          String?
  jobTitle           String?    @db.VarChar(150)
  phone              String?    @db.VarChar(50)
  departmentId       String?    @db.Uuid
  managerUserId      String?    @db.Uuid
  roleId             String     @db.Uuid
  status             UserStatus @default(ACTIVE)
  /// Internal hourly cost — drives Project Profitability view.
  costRate           Decimal?   @db.Decimal(18, 2)
  defaultBillingRate Decimal?   @db.Decimal(18, 2)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  role       SecurityRole @relation(fields: [roleId], references: [id])
  department Department?  @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  manager    User?        @relation("UserHierarchy", fields: [managerUserId], references: [id], onDelete: SetNull)
  reports    User[]       @relation("UserHierarchy")

  managedDepartments Department[] @relation("DepartmentManager")
  managedTeams       Team[]       @relation("TeamManager")
  teamMemberships    TeamMember[]

  ownedCampaigns    Campaign[]
  ownedLeads        Lead[]
  ownedAccounts     Account[]
  ownedOpportunites Opportunity[]
  ownedContracts    Contract[]
  ownedCases        Case[]
  managedProjects   Project[]
  projectMemberships ProjectMember[]
  ownedPhases       ProjectPhase[]
  ownedMilestones   Milestone[]
  assignedTasks     ProjectTask[]
  timeLogs          TimeLog[]        @relation("TimeLogUser")
  approvedTimeLogs  TimeLog[]        @relation("TimeLogApprover")
  trainingsLed      Training[]
  trainingSeats     TrainingParticipant[]
  ownedRisks        ProjectRisk[]
  ownedIssues       ProjectIssue[]
  requestedChanges  ChangeRequest[]
  expenses          Expense[]
  paymentAllocations PaymentAllocation[]
  authoredArticles  KnowledgeArticle[]
  caseComments      CaseComment[]
  slaTimerEvents    SlaTimerEvent[]
  activities        Activity[]
  notes             Note[]
  documents         Document[]
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalsToDecide  ApprovalRequest[] @relation("ApprovalApprover")
  approvalSteps      ApprovalStep[]
  auditEntries      AuditHistory[]
  managedPartners   Partner[]         @relation("PartnerManager")
  approvedCommissions CommissionRecord[] @relation("CommissionApprover")
  approvedPayouts   CommissionPayout[]  @relation("PayoutApprover")

  @@index([departmentId])
  @@index([managerUserId])
  @@index([roleId])
  @@index([status])
  @@map("app_user")
}

model Team {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  teamType      TeamType
  managerUserId String?  @db.Uuid
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  manager       User?          @relation("TeamManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  members       TeamMember[]
  cases         Case[]
  caseCategories CaseCategory[]

  @@index([teamType])
  @@map("team")
}

model TeamMember {
  id         String    @id @default(uuid()) @db.Uuid
  teamId     String    @db.Uuid
  userId     String    @db.Uuid
  roleInTeam String?   @db.VarChar(100)
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

model Currency {
  code      String   @id @db.Char(3)
  name      String   @db.VarChar(100)
  symbol    String?  @db.VarChar(10)
  /// Rate to the company's base currency. Base currency itself is 1.0.
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  isBase    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations       Quotation[]
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  vendorBills      VendorBill[]
  vendorPayments   VendorPayment[]
  bankAccounts     BankAccount[]
  transactions     FinancialTransaction[]
  commissionRecords CommissionRecord[]
  commissionPayouts CommissionPayout[]

  @@map("currency")
}

model TaxRate {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(100)
  ratePercent   Decimal   @db.Decimal(8, 4)
  taxType       TaxType
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products         Product[]
  opportunityLines OpportunityProduct[]
  quoteLines       QuoteLine[]
  invoiceLines     InvoiceLine[]
  vendorBillLines  VendorBillLine[]

  @@map("tax_rate")
}

// ============================================================================
// MARKETING (spec §10.1)
// ============================================================================

model CampaignType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  channel   String?  @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@map("campaign_type")
}

model Campaign {
  id               String         @id @default(uuid()) @db.Uuid
  campaignNumber   String         @unique @db.VarChar(30)
  name             String         @db.VarChar(200)
  campaignTypeId   String         @db.Uuid
  parentCampaignId String?        @db.Uuid
  ownerUserId      String         @db.Uuid
  status           CampaignStatus @default(PLANNED)
  description      String?
  startDate        DateTime?      @db.Date
  endDate          DateTime?      @db.Date
  budgetAmount     Decimal?       @db.Decimal(18, 2)
  actualCost       Decimal?       @db.Decimal(18, 2)
  expectedLeads    Int?
  expectedRevenue  Decimal?       @db.Decimal(18, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  campaignType   CampaignType     @relation(fields: [campaignTypeId], references: [id])
  parentCampaign Campaign?        @relation("CampaignHierarchy", fields: [parentCampaignId], references: [id], onDelete: SetNull)
  childCampaigns Campaign[]       @relation("CampaignHierarchy")
  owner          User             @relation(fields: [ownerUserId], references: [id])
  members        CampaignMember[]
  leads          Lead[]
  opportunities  Opportunity[]

  @@index([status])
  @@index([ownerUserId])
  @@index([campaignTypeId])
  @@map("campaign")
}

model CampaignMember {
  id                String    @id @default(uuid()) @db.Uuid
  campaignId        String    @db.Uuid
  leadId            String?   @db.Uuid
  contactId         String?   @db.Uuid
  memberStatus      String    @default("TARGETED") @db.VarChar(50)
  responded         Boolean   @default(false)
  responseDate      DateTime? @db.Date
  opportunityId     String?   @db.Uuid
  attributedRevenue Decimal?  @db.Decimal(18, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@unique([campaignId, leadId])
  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@map("campaign_member")
}

// ============================================================================
// SALES (spec §10.2)
// ============================================================================

model Lead {
  id                    String     @id @default(uuid()) @db.Uuid
  leadNumber            String     @unique @db.VarChar(30)
  firstName             String     @db.VarChar(100)
  lastName              String     @db.VarChar(100)
  companyName           String?    @db.VarChar(200)
  jobTitle              String?    @db.VarChar(150)
  email                 String?    @db.VarChar(255)
  phone                 String?    @db.VarChar(50)
  whatsapp              String?    @db.VarChar(50)
  industry              String?    @db.VarChar(100)
  leadSource            String?    @db.VarChar(100)
  campaignId            String?    @db.Uuid
  /// Partner that referred this lead — feeds SOURCED attribution on conversion.
  referredByPartnerId   String?    @db.Uuid
  ownerUserId           String     @db.Uuid
  status                LeadStatus @default(NEW)
  rating                LeadRating?
  estimatedValue        Decimal?   @db.Decimal(18, 2)
  description           String?
  nextFollowUpAt        DateTime?
  disqualifiedReason    String?    @db.VarChar(255)
  convertedAt           DateTime?
  convertedAccountId    String?    @db.Uuid
  convertedContactId    String?    @db.Uuid
  convertedOpportunityId String?   @db.Uuid
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  campaign             Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  referredByPartner    Partner?         @relation("PartnerReferredLeads", fields: [referredByPartnerId], references: [id], onDelete: SetNull)
  owner                User             @relation(fields: [ownerUserId], references: [id])
  convertedAccount     Account?         @relation(fields: [convertedAccountId], references: [id], onDelete: SetNull)
  convertedContact     Contact?         @relation(fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity?     @relation(fields: [convertedOpportunityId], references: [id], onDelete: SetNull)
  campaignMembers      CampaignMember[]

  @@index([status])
  @@index([ownerUserId])
  @@index([campaignId])
  @@index([email])
  @@index([referredByPartnerId])
  @@map("lead")
}

model Account {
  id               String          @id @default(uuid()) @db.Uuid
  accountNumber    String          @unique @db.VarChar(30)
  name             String          @db.VarChar(200)
  accountType      AccountType     @default(PROSPECT)
  customerStatus   CustomerStatus?
  parentAccountId  String?         @db.Uuid
  ownerUserId      String          @db.Uuid
  industry         String?         @db.VarChar(100)
  website          String?         @db.VarChar(255)
  mainPhone        String?         @db.VarChar(50)
  employeeCount    Int?
  annualRevenue    Decimal?        @db.Decimal(18, 2)
  taxNumberNtn     String?         @db.VarChar(50)
  billingAddress   Json?
  shippingAddress  Json?
  creditLimit      Decimal?        @db.Decimal(18, 2)
  paymentTermsDays Int?
  customerHealth   HealthStatus?
  description      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  parentAccount  Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts  Account[] @relation("AccountHierarchy")
  owner          User      @relation(fields: [ownerUserId], references: [id])

  contacts       Contact[]
  opportunities  Opportunity[]
  quotations     Quotation[]
  contracts      Contract[]
  cases          Case[]
  projects       Project[]
  trainings      Training[]
  invoices       Invoice[]
  payments       Payment[]
  vendorBills    VendorBill[]
  vendorPayments VendorPayment[]
  expenses       Expense[]
  convertedLeads Lead[]
  /// 1:0..1 — present only when accountType = PARTNER (spec §13 Account roles).
  partner        Partner?

  @@index([accountType])
  @@index([ownerUserId])
  @@index([name])
  @@map("account")
}

model Contact {
  id                   String            @id @default(uuid()) @db.Uuid
  /// NULLABLE (change from spec): an individual partner or a private-person
  /// customer has no employer account. Enforced at the app layer instead.
  accountId            String?           @db.Uuid
  firstName            String            @db.VarChar(100)
  lastName             String            @db.VarChar(100)
  jobTitle             String?           @db.VarChar(150)
  department           String?           @db.VarChar(100)
  email                String?           @db.VarChar(255)
  phone                String?           @db.VarChar(50)
  mobile               String?           @db.VarChar(50)
  whatsapp             String?           @db.VarChar(50)
  contactRole          String?           @db.VarChar(100)
  isPrimary            Boolean           @default(false)
  preferredChannel     PreferredChannel?
  communicationConsent Boolean           @default(false)
  mailingAddress       Json?
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  opportunities       Opportunity[]
  quotations          Quotation[]
  cases               Case[]
  caseComments        CaseComment[]
  campaignMembers     CampaignMember[]
  invoices            Invoice[]
  activities          Activity[]
  trainingSeats       TrainingParticipant[]
  changeRequests      ChangeRequest[]
  convertedFromLeads  Lead[]
  /// Set when this contact IS an individual partner, or is the named
  /// day-to-day person at a partner company.
  partnerAsPerson     Partner?             @relation("PartnerPerson")
  partnerContactRoles PartnerContact[]

  @@index([accountId])
  @@index([email])
  @@map("contact")
}

model Product {
  id               String      @id @default(uuid()) @db.Uuid
  productCode      String      @unique @db.VarChar(50)
  name             String      @db.VarChar(200)
  description      String?
  category         String?     @db.VarChar(100)
  productType      ProductType
  billingType      BillingType
  unitOfMeasure    String?     @db.VarChar(30)
  standardPrice    Decimal?    @db.Decimal(18, 2)
  /// Internal cost — used by Project Profitability and margin-based commission.
  standardCost     Decimal?    @db.Decimal(18, 2)
  defaultTaxRateId String?     @db.Uuid
  /// Optional per-product commission override (beats the plan's flat rate).
  commissionPercent Decimal?   @db.Decimal(8, 4)
  commissionable   Boolean     @default(true)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  defaultTaxRate   TaxRate?             @relation(fields: [defaultTaxRateId], references: [id], onDelete: SetNull)
  opportunityLines OpportunityProduct[]
  quoteLines       QuoteLine[]
  invoiceLines     InvoiceLine[]

  @@index([productType])
  @@index([active])
  @@map("product")
}

model Opportunity {
  id                 String           @id @default(uuid()) @db.Uuid
  opportunityNumber  String           @unique @db.VarChar(30)
  name               String           @db.VarChar(255)
  accountId          String           @db.Uuid
  primaryContactId   String?          @db.Uuid
  ownerUserId        String           @db.Uuid
  campaignId         String?          @db.Uuid
  stage              OpportunityStage @default(DISCOVERY)
  amount             Decimal          @db.Decimal(18, 2)
  currencyCode       String           @default("PKR") @db.Char(3)
  probabilityPercent Decimal          @default(10) @db.Decimal(5, 2)
  expectedCloseDate  DateTime         @db.Date
  actualCloseDate    DateTime?        @db.Date
  opportunityType    OpportunityType  @default(NEW)
  leadSource         String?          @db.VarChar(100)
  nextStep           String?          @db.VarChar(500)
  description        String?
  lossReason         String?          @db.VarChar(255)
  competitorName     String?          @db.VarChar(200)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  account        Account  @relation(fields: [accountId], references: [id])
  primaryContact Contact? @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  owner          User     @relation(fields: [ownerUserId], references: [id])
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  lines             OpportunityProduct[]
  quotations        Quotation[]
  contracts         Contract[]
  projects          Project[]
  campaignMembers   CampaignMember[]
  convertedFromLeads Lead[]
  /// N:M — replaces the spec's single partner_profile_id so a deal can be
  /// sourced by one partner and delivered by another, each with its own split.
  partners          OpportunityPartner[]
  commissionRecords CommissionRecord[]

  @@index([stage])
  @@index([accountId])
  @@index([ownerUserId])
  @@index([expectedCloseDate])
  @@map("opportunity")
}

model OpportunityProduct {
  id              String   @id @default(uuid()) @db.Uuid
  opportunityId   String   @db.Uuid
  productId       String   @db.Uuid
  description     String?
  quantity        Decimal  @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 2)
  discountPercent Decimal? @db.Decimal(8, 4)
  taxRateId       String?  @db.Uuid
  lineTotal       Decimal  @db.Decimal(18, 2)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  taxRate     TaxRate?    @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@map("opportunity_product")
}

model Quotation {
  id             String          @id @default(uuid()) @db.Uuid
  quoteNumber    String          @unique @db.VarChar(30)
  opportunityId  String          @db.Uuid
  accountId      String          @db.Uuid
  contactId      String?         @db.Uuid
  versionNumber  Int             @default(1)
  status         QuotationStatus @default(DRAFT)
  quoteDate      DateTime        @db.Date
  expiryDate     DateTime        @db.Date
  currencyCode   String          @db.Char(3)
  subtotal       Decimal         @default(0) @db.Decimal(18, 2)
  discountAmount Decimal         @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal         @default(0) @db.Decimal(18, 2)
  paymentTerms   String?
  notes          String?
  termsAndConditions String?
  approvalStatus ApprovalStatus  @default(NOT_REQUIRED)
  sentAt         DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id])
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  currency    Currency    @relation(fields: [currencyCode], references: [code])
  lines       QuoteLine[]
  contracts   Contract[]

  @@unique([opportunityId, versionNumber])
  @@index([status])
  @@index([accountId])
  @@map("quotation")
}

model QuoteLine {
  id              String   @id @default(uuid()) @db.Uuid
  quotationId     String   @db.Uuid
  productId       String?  @db.Uuid
  description     String
  quantity        Decimal  @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 2)
  discountPercent Decimal? @db.Decimal(8, 4)
  taxRateId       String?  @db.Uuid
  lineTotal       Decimal  @db.Decimal(18, 2)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxRate   TaxRate?  @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quote_line")
}

model Contract {
  id               String            @id @default(uuid()) @db.Uuid
  contractNumber   String            @unique @db.VarChar(30)
  name             String            @db.VarChar(255)
  accountId        String            @db.Uuid
  opportunityId    String?           @db.Uuid
  quotationId      String?           @db.Uuid
  ownerUserId      String            @db.Uuid
  contractType     String            @db.VarChar(100)
  status           ContractStatus    @default(DRAFT)
  startDate        DateTime          @db.Date
  endDate          DateTime          @db.Date
  contractValue    Decimal           @db.Decimal(18, 2)
  currencyCode     String            @default("PKR") @db.Char(3)
  billingFrequency BillingFrequency?
  renewalType      RenewalType?
  noticePeriodDays Int?
  signedDate       DateTime?         @db.Date
  signedDocumentId String?           @db.Uuid
  terminationReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  account     Account     @relation(fields: [accountId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quotation   Quotation?  @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  owner       User        @relation(fields: [ownerUserId], references: [id])
  projects    Project[]
  cases       Case[]
  invoices    Invoice[]

  @@index([status])
  @@index([accountId])
  @@index([endDate])
  @@map("contract")
}

// ============================================================================
// PARTNER MANAGEMENT + COMMISSIONS  (extension — not in spec v1.0)
// ============================================================================

/// Replaces the spec's `Partner Profile`. A partner is EITHER a company
/// (accountId set, kind = COMPANY) OR an individual (contactId set,
/// kind = INDIVIDUAL). Exactly one must be present — enforced in
/// src/server/partners.ts and by the DB check constraint added in the
/// `partner_identity_check` migration.
model Partner {
  id                String        @id @default(uuid()) @db.Uuid
  partnerNumber     String        @unique @db.VarChar(30)
  /// Denormalised for search + list rendering; kept in sync with the
  /// linked Account.name or Contact full name.
  displayName       String        @db.VarChar(200)
  kind              PartnerKind
  /// Set when kind = COMPANY. 1:0..1 with Account.
  accountId         String?       @unique @db.Uuid
  /// Set when kind = INDIVIDUAL — a partner with no company behind them.
  contactId         String?       @unique @db.Uuid
  partnerType       PartnerType
  tier              PartnerTier   @default(REGISTERED)
  status            PartnerStatus @default(PROSPECTIVE)
  partnerManagerId  String?       @db.Uuid
  territory         String?       @db.VarChar(150)
  startDate         DateTime?     @db.Date
  agreementExpiryDate DateTime?   @db.Date
  agreementDocumentId String?     @db.Uuid
  /// Fallback rate when no CommissionPlan is assigned.
  defaultCommissionPercent Decimal? @db.Decimal(8, 4)
  /// Default plan applied to new deals for this partner.
  commissionPlanId  String?       @db.Uuid
  payoutCurrencyCode String       @default("PKR") @db.Char(3)
  taxNumber         String?       @db.VarChar(50)
  /// Withholding tax deducted at payout time, if any.
  withholdingTaxPercent Decimal?  @db.Decimal(8, 4)
  bankDetails       Json?
  email             String?       @db.VarChar(255)
  phone             String?       @db.VarChar(50)
  website           String?       @db.VarChar(255)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  account        Account?        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation("PartnerPerson", fields: [contactId], references: [id], onDelete: Cascade)
  partnerManager User?           @relation("PartnerManager", fields: [partnerManagerId], references: [id], onDelete: SetNull)
  commissionPlan CommissionPlan? @relation(fields: [commissionPlanId], references: [id], onDelete: SetNull)

  /// Additional named people at a partner company (sales rep, finance contact…).
  contacts          PartnerContact[]
  opportunities     OpportunityPartner[]
  commissionRecords CommissionRecord[]
  payouts           CommissionPayout[]
  referredLeads     Lead[]               @relation("PartnerReferredLeads")

  @@index([status])
  @@index([partnerType])
  @@index([kind])
  @@index([partnerManagerId])
  @@map("partner")
}

/// People at a partner company, beyond the single primary contact.
model PartnerContact {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @db.Uuid
  contactId String   @db.Uuid
  role      String?  @db.VarChar(100)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([partnerId, contactId])
  @@map("partner_contact")
}

/// Junction between a deal and the partner(s) on it. `revenueSharePercent`
/// splits credit when more than one partner is involved; the app validates
/// that the shares for an opportunity sum to <= 100.
model OpportunityPartner {
  id                  String      @id @default(uuid()) @db.Uuid
  opportunityId       String      @db.Uuid
  partnerId           String      @db.Uuid
  role                PartnerRole @default(SOURCED)
  /// Share of the deal credited to this partner (100 = sole partner).
  revenueSharePercent Decimal     @default(100) @db.Decimal(8, 4)
  /// Overrides the partner's plan/default rate for this deal only.
  commissionPercentOverride Decimal? @db.Decimal(8, 4)
  /// Snapshot of the plan in force when the deal was registered, so later
  /// plan edits never retroactively change what was earned.
  commissionPlanId    String?     @db.Uuid
  /// Deal registration — protects a partner's claim for a period.
  registeredAt        DateTime?
  registrationExpiresAt DateTime?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  opportunity    Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  partner        Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  commissionPlan CommissionPlan? @relation(fields: [commissionPlanId], references: [id], onDelete: SetNull)

  commissionRecords CommissionRecord[]

  @@unique([opportunityId, partnerId, role])
  @@index([partnerId])
  @@map("opportunity_partner")
}

/// Rules that turn a won deal into an owed amount.
model CommissionPlan {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(150)
  description  String?
  basis        CommissionBasis    @default(OPPORTUNITY_AMOUNT)
  /// When the liability is recognised. ON_PAYMENT_RECEIVED is the safe
  /// default — you only owe commission once the customer has actually paid.
  trigger      CommissionTrigger  @default(ON_PAYMENT_RECEIVED)
  rateType     CommissionRateType @default(FLAT_PERCENT)
  flatPercent  Decimal?           @db.Decimal(8, 4)
  fixedAmount  Decimal?           @db.Decimal(18, 2)
  /// Commission is not earned on deals below this value.
  minimumDealAmount Decimal?      @db.Decimal(18, 2)
  /// Cap on a single commission record.
  maximumPayout Decimal?          @db.Decimal(18, 2)
  /// Days after the trigger before the record becomes payable.
  payoutDelayDays Int             @default(0)
  /// Reverse commission if the customer refunds/churns within this window.
  clawbackWindowDays Int?
  effectiveFrom DateTime?         @db.Date
  effectiveTo   DateTime?         @db.Date
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  tiers              CommissionTier[]
  partners           Partner[]
  opportunityPartners OpportunityPartner[]
  commissionRecords  CommissionRecord[]

  @@map("commission_plan")
}

/// Volume tiers for rateType = TIERED_PERCENT, e.g. 0–1M → 5%, 1M+ → 8%.
model CommissionTier {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @db.Uuid
  fromAmount  Decimal  @db.Decimal(18, 2)
  toAmount    Decimal? @db.Decimal(18, 2)
  ratePercent Decimal  @db.Decimal(8, 4)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan CommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("commission_tier")
}

/// One earned commission line. This is the ledger — what you owe, to whom,
/// for which deal, and how far through the approve→pay cycle it is.
model CommissionRecord {
  id                   String           @id @default(uuid()) @db.Uuid
  commissionNumber     String           @unique @db.VarChar(30)
  partnerId            String           @db.Uuid
  opportunityId        String           @db.Uuid
  opportunityPartnerId String?          @db.Uuid
  planId               String?          @db.Uuid
  /// Set when the trigger is invoice- or payment-based, so a staged deal
  /// produces one record per invoice rather than one lump sum.
  invoiceId            String?          @db.Uuid
  paymentId            String?          @db.Uuid
  status               CommissionStatus @default(ACCRUED)
  basis                CommissionBasis
  /// The money the rate was applied to (after revenue-share split).
  basisAmount          Decimal          @db.Decimal(18, 2)
  ratePercent          Decimal?         @db.Decimal(8, 4)
  /// basisAmount x ratePercent, or the plan's fixed amount.
  commissionAmount     Decimal          @db.Decimal(18, 2)
  withholdingTaxAmount Decimal          @default(0) @db.Decimal(18, 2)
  /// commissionAmount - withholdingTaxAmount. What actually leaves the bank.
  netPayableAmount     Decimal          @db.Decimal(18, 2)
  currencyCode         String           @db.Char(3)
  earnedDate           DateTime         @db.Date
  /// Not payable before this date (plan.payoutDelayDays).
  payableFromDate      DateTime?        @db.Date
  approvedById         String?          @db.Uuid
  approvedAt           DateTime?
  rejectionReason      String?
  payoutId             String?          @db.Uuid
  paidAt               DateTime?
  /// Set when a CLAWED_BACK record reverses an earlier one.
  reversesRecordId     String?          @unique @db.Uuid
  calculationNotes     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  partner            Partner             @relation(fields: [partnerId], references: [id])
  opportunity        Opportunity         @relation(fields: [opportunityId], references: [id])
  opportunityPartner OpportunityPartner? @relation(fields: [opportunityPartnerId], references: [id], onDelete: SetNull)
  plan               CommissionPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment            Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  currency           Currency            @relation(fields: [currencyCode], references: [code])
  approvedBy         User?               @relation("CommissionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  payout             CommissionPayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  reversesRecord     CommissionRecord?   @relation("CommissionReversal", fields: [reversesRecordId], references: [id], onDelete: SetNull)
  reversedBy         CommissionRecord?   @relation("CommissionReversal")

  /// One commission per partner per deal per triggering document.
  @@unique([opportunityPartnerId, invoiceId, paymentId])
  @@index([partnerId])
  @@index([opportunityId])
  @@index([status])
  @@index([earnedDate])
  @@map("commission_record")
}

/// A batch payment to a partner covering one or more commission records.
model CommissionPayout {
  id             String        @id @default(uuid()) @db.Uuid
  payoutNumber   String        @unique @db.VarChar(30)
  partnerId      String        @db.Uuid
  status         PayoutStatus  @default(DRAFT)
  periodStart    DateTime?     @db.Date
  periodEnd      DateTime?     @db.Date
  grossAmount    Decimal       @default(0) @db.Decimal(18, 2)
  withholdingTaxAmount Decimal @default(0) @db.Decimal(18, 2)
  netAmount      Decimal       @default(0) @db.Decimal(18, 2)
  currencyCode   String        @db.Char(3)
  paymentMethod  PaymentMethod?
  bankAccountId  String?       @db.Uuid
  referenceNumber String?      @db.VarChar(100)
  paymentDate    DateTime?     @db.Date
  approvedById   String?       @db.Uuid
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  partner     Partner            @relation(fields: [partnerId], references: [id])
  currency    Currency           @relation(fields: [currencyCode], references: [code])
  bankAccount BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  approvedBy  User?              @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  records     CommissionRecord[]

  @@index([partnerId])
  @@index([status])
  @@map("commission_payout")
}

// ============================================================================
// SUPPORT (spec §10.3)
// ============================================================================

model CaseCategory {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(150)
  parentCategoryId String?  @db.Uuid
  defaultTeamId    String?  @db.Uuid
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentCategory   CaseCategory?      @relation("CaseCategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories  CaseCategory[]     @relation("CaseCategoryHierarchy")
  defaultTeam      Team?              @relation(fields: [defaultTeamId], references: [id], onDelete: SetNull)
  cases            Case[]
  knowledgeArticles KnowledgeArticle[]

  @@map("case_category")
}

model BusinessHours {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  timezone        String   @db.VarChar(100)
  /// { "mon": [["09:00","18:00"]], "sat": [], ... }
  weeklySchedule  Json
  holidayCalendar Json?
  isDefault       Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  slaPolicies SlaPolicy[]

  @@map("business_hours")
}

model SlaPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(150)
  priority             Priority
  firstResponseMinutes Int
  resolutionMinutes    Int
  businessHoursId      String?  @db.Uuid
  pauseOnCustomerWait  Boolean  @default(true)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  businessHours BusinessHours? @relation(fields: [businessHoursId], references: [id], onDelete: SetNull)
  cases         Case[]

  @@map("sla_policy")
}

model Case {
  id                  String     @id @default(uuid()) @db.Uuid
  caseNumber          String     @unique @db.VarChar(30)
  subject             String     @db.VarChar(500)
  description         String
  accountId           String     @db.Uuid
  contactId           String?    @db.Uuid
  projectId           String?    @db.Uuid
  contractId          String?    @db.Uuid
  categoryId          String?    @db.Uuid
  ownerUserId         String?    @db.Uuid
  teamId              String?    @db.Uuid
  slaPolicyId         String?    @db.Uuid
  caseType            CaseType   @default(INCIDENT)
  priority            Priority   @default(MEDIUM)
  status              CaseStatus @default(NEW)
  source              CaseSource @default(EMAIL)
  firstResponseDueAt  DateTime?
  firstRespondedAt    DateTime?
  resolutionDueAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  reopenCount         Int        @default(0)
  slaBreached         Boolean    @default(false)
  rootCause           String?
  resolution          String?
  satisfactionScore   Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  account   Account       @relation(fields: [accountId], references: [id])
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract  Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  category  CaseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner     User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  team      Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  slaPolicy SlaPolicy?    @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)

  comments       CaseComment[]
  slaTimerEvents SlaTimerEvent[]
  timeLogs       TimeLog[]

  @@index([status])
  @@index([accountId])
  @@index([ownerUserId])
  @@index([teamId])
  @@index([priority])
  @@index([resolutionDueAt])
  @@map("support_case")
}

model CaseComment {
  id               String          @id @default(uuid()) @db.Uuid
  caseId           String          @db.Uuid
  authorUserId     String?         @db.Uuid
  authorContactId  String?         @db.Uuid
  commentType      CaseCommentType
  body             String
  isPublic         Boolean         @default(false)
  timeSpentMinutes Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorUser    User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorContact Contact? @relation(fields: [authorContactId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("case_comment")
}

model SlaTimerEvent {
  id                   String       @id @default(uuid()) @db.Uuid
  caseId               String       @db.Uuid
  eventType            SlaEventType
  eventAt              DateTime
  reason               String?      @db.VarChar(255)
  businessMinutesDelta Int?
  createdById          String?      @db.Uuid
  createdAt            DateTime     @default(now())

  case      Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("sla_timer_event")
}

model KnowledgeArticle {
  id            String            @id @default(uuid()) @db.Uuid
  articleNumber String            @unique @db.VarChar(30)
  title         String            @db.VarChar(500)
  summary       String?
  content       String
  categoryId    String?           @db.Uuid
  status        ArticleStatus     @default(DRAFT)
  versionNumber Int               @default(1)
  authorUserId  String            @db.Uuid
  publishedAt   DateTime?
  visibility    ArticleVisibility @default(INTERNAL)
  viewCount     Int               @default(0)
  helpfulCount  Int               @default(0)
  tags          String[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  category CaseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User          @relation(fields: [authorUserId], references: [id])

  @@index([status])
  @@index([categoryId])
  @@map("knowledge_article")
}

// ============================================================================
// PROFESSIONAL SERVICES (spec §10.4)
// ============================================================================

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  projectNumber     String        @unique @db.VarChar(30)
  name              String        @db.VarChar(255)
  accountId         String        @db.Uuid
  opportunityId     String?       @db.Uuid
  contractId        String?       @db.Uuid
  projectManagerId  String        @db.Uuid
  status            ProjectStatus @default(DRAFT)
  health            HealthStatus  @default(GREEN)
  billingType       BillingType
  startDate         DateTime?     @db.Date
  plannedEndDate    DateTime?     @db.Date
  actualEndDate     DateTime?     @db.Date
  contractValue     Decimal?      @db.Decimal(18, 2)
  currencyCode      String        @default("PKR") @db.Char(3)
  approvedHours     Decimal?      @db.Decimal(18, 2)
  completionPercent Decimal       @default(0) @db.Decimal(5, 2)
  scope             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  account        Account      @relation(fields: [accountId], references: [id])
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contract       Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  projectManager User         @relation(fields: [projectManagerId], references: [id])

  members        ProjectMember[]
  phases         ProjectPhase[]
  milestones     Milestone[]
  tasks          ProjectTask[]
  timeLogs       TimeLog[]
  trainings      Training[]
  risks          ProjectRisk[]
  issues         ProjectIssue[]
  changeRequests ChangeRequest[]
