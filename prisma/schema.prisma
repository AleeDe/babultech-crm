  @@unique([projectId, sequenceNumber])
  @@index([projectId])
  @@map("project_phase")
}

model Milestone {
  id                       String          @id @default(uuid()) @db.Uuid
  projectId                String          @db.Uuid
  phaseId                  String?         @db.Uuid
  name                     String          @db.VarChar(255)
  description              String?
  ownerUserId              String?         @db.Uuid
  dueDate                  DateTime        @db.Date
  completedDate            DateTime?       @db.Date
  status                   MilestoneStatus @default(PLANNED)
  customerApprovalRequired Boolean         @default(false)
  customerApprovalDate     DateTime?       @db.Date
  billingTrigger           Boolean         @default(false)
  billingPercent           Decimal?        @db.Decimal(8, 4)
  billingAmount            Decimal?        @db.Decimal(18, 2)
  invoicedAt               DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  owner        User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  tasks        ProjectTask[]
  invoices     Invoice[]
  invoiceLines InvoiceLine[]

  @@index([projectId])
  @@index([dueDate])
  @@map("milestone")
}

model ProjectTask {
  id                 String     @id @default(uuid()) @db.Uuid
  projectId          String     @db.Uuid
  phaseId            String?    @db.Uuid
  milestoneId        String?    @db.Uuid
  parentTaskId       String?    @db.Uuid
  name               String     @db.VarChar(255)
  description        String?
  assignedUserId     String?    @db.Uuid
  status             TaskStatus @default(NOT_STARTED)
  priority           Priority   @default(MEDIUM)
  startDate          DateTime?  @db.Date
  dueDate            DateTime?  @db.Date
  completedDate      DateTime?  @db.Date
  estimatedHours     Decimal?   @db.Decimal(18, 2)
  completionPercent  Decimal    @default(0) @db.Decimal(5, 2)
  billable           Boolean    @default(true)
  acceptanceCriteria String?
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentTask   ProjectTask?  @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     ProjectTask[] @relation("TaskHierarchy")
  assignedUser User?         @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  timeLogs     TimeLog[]

  @@index([projectId])
  @@index([assignedUserId])
  @@index([status])
  @@index([dueDate])
  @@map("project_task")
}

model TimeLog {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  projectId      String?            @db.Uuid
  projectTaskId  String?            @db.Uuid
  caseId         String?            @db.Uuid
  workDate       DateTime           @db.Date
  hours          Decimal            @db.Decimal(8, 2)
  description    String
  billable       Boolean            @default(true)
  billingRate    Decimal?           @db.Decimal(18, 2)
  costRate       Decimal?           @db.Decimal(18, 2)
  approvalStatus TimeApprovalStatus @default(DRAFT)
  approvedById   String?            @db.Uuid
  approvedAt     DateTime?
  invoiceLineId  String?            @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user        User         @relation("TimeLogUser", fields: [userId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectTask ProjectTask? @relation(fields: [projectTaskId], references: [id], onDelete: SetNull)
  case        Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  approvedBy  User?        @relation("TimeLogApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  invoiceLine InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@index([userId, workDate])
  @@index([projectId])
  @@index([approvalStatus])
  @@map("time_log")
}

model Training {
