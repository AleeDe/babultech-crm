model BankAccount {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String          @db.VarChar(150)
  bankName            String?         @db.VarChar(150)
  accountNumberMasked String?         @db.VarChar(100)
  iban                String?         @db.VarChar(100)
  currencyCode        String          @db.Char(3)
  accountType         BankAccountType @default(BANK)
  openingBalance      Decimal         @default(0) @db.Decimal(18, 2)
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  currency       Currency               @relation(fields: [currencyCode], references: [code])
  payments       Payment[]
  vendorPayments VendorPayment[]
  transactions   FinancialTransaction[]
  payouts        CommissionPayout[]

  @@map("bank_account")
}

model FinancialTransaction {
  id                String               @id @default(uuid()) @db.Uuid
  transactionNumber String               @unique @db.VarChar(30)
  transactionDate   DateTime             @db.Date
  transactionType   TransactionType
  direction         TransactionDirection
  amount            Decimal              @db.Decimal(18, 2)
  currencyCode      String               @db.Char(3)
  bankAccountId     String?              @db.Uuid
  /// Polymorphic source: Payment | VendorPayment | Expense | CommissionPayout.
  sourceEntityType  String?              @db.VarChar(50)
  sourceEntityId    String?              @db.Uuid
  status            TransactionStatus    @default(PENDING)
  reference         String?              @db.VarChar(255)
  description       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  currency    Currency     @relation(fields: [currencyCode], references: [code])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([transactionDate])
  @@index([sourceEntityType, sourceEntityId])
  @@map("financial_transaction")
}

