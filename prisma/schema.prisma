// BabulTech CRM — logical data model
// Implements the entity dictionary from "BabulTech CRM Complete ERD and Data Model" v1.0
// plus the Partner Management + Commission extensions (see §Partner Management below).
//
// Conventions (spec §1.1):
//   - UUID primary keys; human-readable numbers are separate unique fields.
//   - Every mutable table carries createdAt/updatedAt/createdById/updatedById + deletedAt soft delete.
//   - Money is Decimal(18,2) and always travels with a currencyCode.
//   - Polymorphic parents (entityType/entityId) only on Activity, Email, Note, Document,
//     ApprovalRequest, AuditHistory. Everything else uses explicit FKs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

