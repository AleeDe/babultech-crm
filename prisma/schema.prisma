// ============================================================================
// FINANCE (spec §10.5)
// ============================================================================

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceNumber     String        @unique @db.VarChar(30)
  accountId         String        @db.Uuid
  contactId         String?       @db.Uuid
  projectId         String?       @db.Uuid
  contractId        String?       @db.Uuid
  milestoneId       String?       @db.Uuid
  invoiceDate       DateTime      @db.Date
  dueDate           DateTime      @db.Date
  status            InvoiceStatus @default(DRAFT)
  currencyCode      String        @db.Char(3)
  subtotal          Decimal       @default(0) @db.Decimal(18, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal       @default(0) @db.Decimal(18, 2)
  /// Sum of valid PaymentAllocations. Maintained by the app, never edited.
  paidAmount        Decimal       @default(0) @db.Decimal(18, 2)
  /// totalAmount - paidAmount - writeOffAmount (spec §13 Invoice balance).
  outstandingAmount Decimal       @default(0) @db.Decimal(18, 2)
  writeOffAmount    Decimal       @default(0) @db.Decimal(18, 2)
  paymentTermsDays  Int?
  notes             String?
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  account   Account    @relation(fields: [accountId], references: [id])
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract  Contract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  currency  Currency   @relation(fields: [currencyCode], references: [code])

  lines             InvoiceLine[]
  allocations       PaymentAllocation[]
  commissionRecords CommissionRecord[]

  @@index([status])
  @@index([accountId])
  @@index([dueDate])
  @@map("invoice")
}

model InvoiceLine {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceId       String   @db.Uuid
  productId       String?  @db.Uuid
  projectId       String?  @db.Uuid
  milestoneId     String?  @db.Uuid
  description     String
  quantity        Decimal  @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 2)
  discountPercent Decimal? @db.Decimal(8, 4)
  taxRateId       String?  @db.Uuid
  lineTotal       Decimal  @db.Decimal(18, 2)
  revenueCategory String?  @db.VarChar(100)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  taxRate   TaxRate?   @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  timeLogs  TimeLog[]

  @@index([invoiceId])
  @@map("invoice_line")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  paymentNumber   String        @unique @db.VarChar(30)
  accountId       String        @db.Uuid
  paymentDate     DateTime      @db.Date
  amount          Decimal       @db.Decimal(18, 2)
  /// amount - sum(allocations). Drives the "unapplied cash" report.
  unallocatedAmount Decimal     @default(0) @db.Decimal(18, 2)
  currencyCode    String        @db.Char(3)
  paymentMethod   PaymentMethod
  bankAccountId   String?       @db.Uuid
  referenceNumber String?       @db.VarChar(100)
  status          PaymentStatus @default(PENDING)
  clearedAt       DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  account     Account      @relation(fields: [accountId], references: [id])
  currency    Currency     @relation(fields: [currencyCode], references: [code])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  allocations       PaymentAllocation[]
  commissionRecords CommissionRecord[]

  @@index([accountId])
  @@index([status])
  @@index([paymentDate])
  @@map("payment")
}

model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @db.Uuid
  invoiceId       String   @db.Uuid
  allocatedAmount Decimal  @db.Decimal(18, 2)
  allocatedAt     DateTime @default(now())
  allocatedById   String   @db.Uuid

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  allocatedBy User    @relation(fields: [allocatedById], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

model ExpenseCategory {
