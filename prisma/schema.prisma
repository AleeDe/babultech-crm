  @@map("project_risk")
}

model ProjectIssue {
  id             String      @id @default(uuid()) @db.Uuid
  projectId      String      @db.Uuid
  title          String      @db.VarChar(255)
  description    String
  severity       Priority    @default(MEDIUM)
  ownerUserId    String      @db.Uuid
