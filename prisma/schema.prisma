model Activity {
  id                String         @id @default(uuid()) @db.Uuid
  activityType      ActivityType
  subject           String         @db.VarChar(255)
  description       String?
  ownerUserId       String         @db.Uuid
  contactId         String?        @db.Uuid
  relatedEntityType String?        @db.VarChar(50)
  relatedEntityId   String?        @db.Uuid
  startAt           DateTime?
  dueAt             DateTime?
  completedAt       DateTime?
  priority          Priority       @default(MEDIUM)
  status            ActivityStatus @default(OPEN)
  outcome           String?
  location          String?        @db.VarChar(255)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  owner   User     @relation(fields: [ownerUserId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, status])
  @@index([relatedEntityType, relatedEntityId])
  @@index([dueAt])
  @@map("activity")
}

model Email {
  id                String         @id @default(uuid()) @db.Uuid
  direction         EmailDirection
  subject           String         @db.VarChar(500)
  fromAddress       String         @db.VarChar(255)
  toAddresses       Json
  ccAddresses       Json?
  bodyHtml          String?
  bodyText          String?
  messageId         String?        @unique @db.VarChar(500)
  threadId          String?        @db.VarChar(500)
  relatedEntityType String?        @db.VarChar(50)
  relatedEntityId   String?        @db.Uuid
  sentReceivedAt    DateTime
  status            EmailStatus    @default(RECEIVED)
  hasAttachments    Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([relatedEntityType, relatedEntityId])
  @@index([threadId])
  @@map("email")
}

model Note {
  id                String         @id @default(uuid()) @db.Uuid
  title             String?        @db.VarChar(255)
  content           String
  relatedEntityType String         @db.VarChar(50)
  relatedEntityId   String         @db.Uuid
  visibility        NoteVisibility @default(TEAM)
  createdById       String         @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([relatedEntityType, relatedEntityId])
  @@map("note")
}

model Document {
  id                String   @id @default(uuid()) @db.Uuid
  fileName          String   @db.VarChar(255)
  storageUrl        String
  mimeType          String   @db.VarChar(100)
  fileSizeBytes     BigInt
  category          String?  @db.VarChar(100)
  versionNumber     Int      @default(1)
  relatedEntityType String   @db.VarChar(50)
  relatedEntityId   String   @db.Uuid
  uploadedById      String   @db.Uuid
  confidential      Boolean  @default(false)
  checksum          String?  @db.VarChar(128)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([relatedEntityType, relatedEntityId])
  @@map("document")
}

model ApprovalRequest {
  id                String         @id @default(uuid()) @db.Uuid
  approvalType      String         @db.VarChar(100)
  relatedEntityType String         @db.VarChar(50)
  relatedEntityId   String         @db.Uuid
  requestedById     String         @db.Uuid
  currentApproverId String?        @db.Uuid
  status            ApprovalStatus @default(PENDING)
  requestedAt       DateTime       @default(now())
  decidedAt         DateTime?
  comments          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  requestedBy     User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  currentApprover User?          @relation("ApprovalApprover", fields: [currentApproverId], references: [id], onDelete: SetNull)
  steps           ApprovalStep[]

  @@index([relatedEntityType, relatedEntityId])
  @@index([status, currentApproverId])
  @@map("approval_request")
}

/// Multi-level approval chains (spec §14 Phase 5). One row per approver hop.
model ApprovalStep {
  id                String         @id @default(uuid()) @db.Uuid
  approvalRequestId String         @db.Uuid
  stepNumber        Int
  approverUserId    String         @db.Uuid
  status            ApprovalStatus @default(PENDING)
  decidedAt         DateTime?
  comments          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approver        User            @relation(fields: [approverUserId], references: [id])

  @@unique([approvalRequestId, stepNumber])
  @@map("approval_step")
}

model AuditHistory {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @db.VarChar(50)
  entityId    String   @db.Uuid
  fieldName   String   @db.VarChar(100)
  oldValue    String?
  newValue    String?
  changedById String?  @db.Uuid
  changedAt   DateTime @default(now())
  source      String?  @db.VarChar(50)

  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([changedAt])
  @@map("audit_history")
}

/// Controlled sequences for human-readable numbers (spec §1.1).
model NumberSequence {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String   @unique @db.VarChar(50)
  prefix        String   @db.VarChar(20)
  nextValue     Int      @default(1)
  paddingLength Int      @default(5)
  /// Include the year in the number, e.g. OPP-2026-00042.
  includeYear   Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("number_sequence")
}
